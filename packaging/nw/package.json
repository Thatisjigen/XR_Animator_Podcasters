{
  "name": "xr-animator-podcasters-bundled",
  "main": "launcher.js",
  "single-instance": true,
  "chromium-args": "--enable-webaudio-input --auto-accept-camera-and-microphone-capture --autoplay-policy=no-user-gesture-required --enable-features=UseOzonePlatform,AcceleratedVideoDecodeLinuxGL,VaapiVideoDecoder,AcceleratedVideoDecodeLinuxZeroCopyGL --ozone-platform-hint=auto --enable-gpu-rasterization --disable-breakpad --disable-sync --disable-speech-api --disable-component-update --disable-background-networking --disable-translate --no-default-browser-check --no-pings --disable-domain-reliability --disable-client-side-phishing-detection --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows",
  "node-remote": [
    "http://127.0.0.1:*",
    "http://localhost:*"
  ],
  "window": {
    "show": false
  }
}
